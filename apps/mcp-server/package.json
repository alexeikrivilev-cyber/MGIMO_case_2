{
  "name": "@udgu/mcp-server",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "main": "./src/index.ts",
  "types": "./src/index.ts",
  "exports": {
    ".": "./src/index.ts",
    "./tools": "./src/tools.ts",
    "./server": "./src/server.ts",
    "./dist": "./dist/index.js"
  },
  "scripts": {
    "mcp:serve": "node --import tsx src/index.ts --transport stdio",
    "mcp:serve:http": "node --import tsx src/index.ts --transport http",
    "typecheck": "tsc --noEmit",
    "test": "node --import tsx --test --test-concurrency=1 test/*.test.ts",
    "build": "tsc -p tsconfig.build.json",
    "start": "node --import tsx dist/index.js",
    "dev": "tsx src/index.ts"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.32.2",
    "@udgu/core": "*",
    "zod": "^4.1.5"
  },
  "devDependencies": {
    "@types/node": "^24.10.1",
    "tsx": "^4.23.15",
    "typescript": "^5.9.3"
  }
}
