{
  "name": "horizon-digital-deanery",
  "version": "0.1.0",
  "private": true,
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "dev": "npm run dev --workspace=@horizon/web",
    "build": "npm run build --workspaces --if-present",
    "db:migrate": "npm run db:migrate --workspace=@horizon/db",
    "db:seed": "npm run db:seed --workspace=@horizon/db",
    "db:reset": "npm run db:reset --workspace=@horizon/db"
  },
  "engines": {
    "node": ">=24.0.0"
  },
  "allowScripts": {
    "@prisma/engines@7.10.1": true,
    "esbuild@0.28.2": true,
    "prisma@7.10.1": true
  }
}
