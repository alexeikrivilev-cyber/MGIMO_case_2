{
  "name": "horizon-deanery",
  "version": "0.1.0",
  "private": true,
  "description": "Цифровой деканат будущего — прототип личного кабинета студента Университета «Горизонт»",
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "engines": {
    "node": ">=22.0.0"
  },
  "scripts": {
    "dev": "npm run dev -w @horizon/web",
    "build": "npm run build -w @horizon/db && npm run build -w @horizon/web",
    "start": "npm run start -w @horizon/web",
    "db:generate": "npm run db:generate -w @horizon/db",
    "db:migrate": "npm run db:migrate -w @horizon/db",
    "db:deploy": "npm run db:deploy -w @horizon/db",
    "db:seed": "npm run db:seed -w @horizon/db",
    "db:reset": "npm run db:reset -w @horizon/db",
    "test": "npm test -w @horizon/db",
    "typecheck": "npm run typecheck --workspaces --if-present"
  },
  "devDependencies": {
    "@types/node": "^24.10.1",
    "tsx": "^4.23.15",
    "typescript": "^5.9.3"
  },
  "allowScripts": {
    "argon2@0.45.2": true,
    "prisma@7.10.1": true,
    "esbuild@0.28.2": true,
    "@prisma/engines@7.10.1": true,
    "sharp@0.34.5": true
  }
}
