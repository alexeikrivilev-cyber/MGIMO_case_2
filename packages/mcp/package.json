{
  "name": "@udgu/mcp",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "main": "./src/index.ts",
  "types": "./src/index.ts",
  "exports": {
    ".": "./src/index.ts",
    "./server": "./src/server.ts",
    "./protocol": "./src/protocol.ts"
  },
  "scripts": {
    "mcp:serve": "node --import tsx src/serve.ts",
    "typecheck": "tsc --noEmit",
    "test": "node --import tsx --test --test-concurrency=1 test/*.test.ts",
    "build": "tsc -p tsconfig.build.json"
  },
  "dependencies": {
    "@udgu/core": "*",
    "zod": "^4.1.5"
  },
  "devDependencies": {
    "@types/node": "^24.10.1",
    "tsx": "^4.23.15",
    "typescript": "^5.9.3"
  }
}
