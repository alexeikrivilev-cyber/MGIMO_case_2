generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

enum UserRole {
  STUDENT
  STAFF
  ADMIN
}

enum LessonType {
  LECTURE
  SEMINAR
  LAB
}

enum ScheduleStatus {
  SCHEDULED
  MOVED
  CANCELLED
}

enum GradeType {
  EXAM
  PASS
  COURSEWORK
}

enum RequestType {
  CERTIFICATE
  APPLICATION
}

enum RequestStatus {
  NEW
  IN_PROGRESS
  READY
  REJECTED
}

enum Audience {
  ALL
  FACULTY
  GROUP
}

enum NotificationType {
  ANNOUNCEMENT
  SCHEDULE_CHANGE
  GRADE
  REQUEST_STATUS
  DEADLINE
  SYSTEM
}

model User {
  id           String   @id @default(cuid())
  login        String   @unique
  passwordHash String
  role         UserRole
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  student       Student?
  teacher       Teacher?
  sessions      Session[]
  notifications Notification[]
  announcements Announcement[]
  auditEvents   AuditEvent[]
}

model Student {
  id               String   @id @default(cuid())
  fullName         String
  faculty          String
  direction        String
  course           Int
  email            String   @unique
  recordBookNumber String   @unique
  groupId          String
  userId           String?  @unique
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt

  group    Group     @relation(fields: [groupId], references: [id])
  user     User?     @relation(fields: [userId], references: [id])
  grades   Grade[]
  requests Request[]
}

model Teacher {
  id         String   @id @default(cuid())
  fullName   String
  department String
  position   String
  userId     String?  @unique
  createdAt  DateTime @default(now())

  user     User?           @relation(fields: [userId], references: [id])
  schedule ScheduleEntry[]
}

model Group {
  id        String @id @default(cuid())
  name      String @unique
  faculty   String
  course    Int
  direction String

  students      Student[]
  schedule      ScheduleEntry[]
  announcements Announcement[]
}

model Subject {
  id   String @id @default(cuid())
  name String
  code String @unique

  grades   Grade[]
  schedule ScheduleEntry[]
}

model ScheduleEntry {
  id        String         @id @default(cuid())
  groupId   String
  subjectId String
  teacherId String
  date      DateTime
  startTime String
  endTime   String
  room      String
  type      LessonType
  status    ScheduleStatus @default(SCHEDULED)
  note      String?

  group   Group   @relation(fields: [groupId], references: [id])
  subject Subject @relation(fields: [subjectId], references: [id])
  teacher Teacher @relation(fields: [teacherId], references: [id])

  @@index([date])
  @@index([groupId, date])
}

model Grade {
  id        String    @id @default(cuid())
  studentId String
  subjectId String
  value     String
  type      GradeType
  date      DateTime
  semester  Int

  student Student @relation(fields: [studentId], references: [id])
  subject Subject @relation(fields: [subjectId], references: [id])

  @@index([studentId, semester])
}

model Request {
  id        String        @id @default(cuid())
  studentId String
  type      RequestType
  formData  Json
  status    RequestStatus @default(NEW)
  comment   String?
  createdAt DateTime      @default(now())
  updatedAt DateTime      @updatedAt

  student Student @relation(fields: [studentId], references: [id])
}

model Announcement {
  id        String   @id @default(cuid())
  title     String
  body      String
  audience  Audience
  faculty   String?
  groupId   String?
  pinned    Boolean  @default(false)
  authorId  String
  createdAt DateTime @default(now())

  author User   @relation(fields: [authorId], references: [id])
  group  Group? @relation(fields: [groupId], references: [id])
}

model Notification {
  id        String           @id @default(cuid())
  userId    String
  type      NotificationType
  title     String
  body      String
  read      Boolean          @default(false)
  link      String?
  createdAt DateTime         @default(now())

  user User @relation(fields: [userId], references: [id])

  @@index([userId, read])
}

model Session {
  id        String   @id @default(cuid())
  userId    String
  tokenHash String   @unique
  expiresAt DateTime
  createdAt DateTime @default(now())

  user User @relation(fields: [userId], references: [id])

  @@index([userId])
}

model AuditEvent {
  id        String   @id @default(cuid())
  actorId   String?
  action    String
  entity    String
  entityId  String?
  meta      Json?
  createdAt DateTime @default(now())

  actor User? @relation(fields: [actorId], references: [id])

  @@index([createdAt])
}
