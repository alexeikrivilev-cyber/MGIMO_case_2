// Prisma 7: datasource БЕЗ url — строка подключения задаётся в prisma.config.ts
// через process.env.DATABASE_URL и пробрасывается в адаптер PrismaPg.
generator client {
  provider = "prisma-client"
  output   = "../src/generated"
}

datasource db {
  provider = "postgresql"
}

enum Role {
  STUDENT
  STAFF
  ADMIN
}

enum ScheduleType {
  LECTURE
  SEMINAR
  LAB
}

enum ScheduleStatus {
  SCHEDULED
  MOVED
  CANCELLED
}

enum GradeType {
  EXAM
  CREDIT
  COURSEWORK
}

enum RequestType {
  REFERENCE
  APPLICATION
}

enum RequestStatus {
  NEW
  IN_PROGRESS
  READY
  REJECTED
}

enum AnnouncementAudience {
  ALL
  FACULTY
  GROUP
}

enum NotificationType {
  SCHEDULE_CHANGE
  GRADE
  REQUEST_STATUS
  ANNOUNCEMENT
  DEADLINE
  SYSTEM
  /// Сообщение в переписке студент ↔ преподаватель (P2a).
  MESSAGE
}

/// Решение по верификации студенческого билета.
enum VerificationStatus {
  PENDING
  VERIFIED
  REJECTED
}

/// Провайдер OAuth-входа (в прототипе — эмуляция согласия, без реальных ключей).
/// Одно и то же перечисление идентифицирует КАНАЛ доступа: Telegram-бот,
/// VK-бот и MAX-бот работают с той же учётной записью через OAuthAccount
/// (BRIEF v3 «Каналы доступа»), второй стороны идентичностей нет.
enum OAuthProvider {
  VK_ID
  MAX
  TELEGRAM
}

/// Статус записи outbox доставки уведомления в канал (BRIEF v3).
/// PENDING — ждёт отправки адаптером канала; SENT — доставлено живым
/// адаптером; DEMO — канал в демо-режиме (адаптера нет, ключи бота не
/// заданы); FAILED — адаптер отрапортовал сбой, текст ошибки в error.
enum ChannelDeliveryStatus {
  PENDING
  SENT
  DEMO
  FAILED
}

/// Тип часа приёма преподавателя.
enum OfficeHourType {
  CONSULTATION
  RECEPTION
  EXTRA_CLASS
}

model User {
  id           String   @id @default(uuid())
  login        String   @unique
  passwordHash String
  role         Role
  createdAt    DateTime @default(now())
  /// Факультет (институт) сотрудника деканата: очередь заявок, верификаций,
  /// болезней и расписание сотрудника ограничены этим факультетом
  /// (ARCHITECTURE §4: «сотрудник деканата — свой факультет; админ — всё»).
  ///
  /// ЗАПОЛНЯЕТСЯ ТОЛЬКО У СОТРУДНИКОВ ДЕКАНАТА (role=STAFF):
  /// - у ADMIN null — админ видит все факультеты (allFaculties);
  /// - у преподавателя (STAFF + профиль Teacher) null — его кабинет
  ///   отдельная фича, в деканат он не попадает (fail-closed);
  /// - у студента null — студенту факультет не нужен, он берётся из Student.
  faculty      String?

  student       Student?
  teacher       Teacher?
  sessions      Session[]
  notifications Notification[]
  announcements Announcement[]
  auditEvents   AuditEvent[]
  oauthAccounts OAuthAccount[]
  reviewedVerifications StudentVerification[] @relation("VerificationReviewer")
  messages      Message[]
  botLinkCodes BotLinkCode[]
  channelDeliveries ChannelDelivery[]

  @@index([faculty])
  @@map("users")
}

model Student {
  id               String  @id @default(uuid())
  userId           String  @unique
  lastName         String
  firstName        String
  middleName       String?
  faculty          String
  direction        String
  course           Int
  groupId          String
  email            String  @unique
  studentCardNumber String @unique
  phone            String?

  user   User   @relation(fields: [userId], references: [id], onDelete: Restrict)
  group  Group  @relation(fields: [groupId], references: [id], onDelete: Restrict)
  grades Grade[]
  requests Request[]
  verification StudentVerification?
  sickLeaves SickLeave[]
  conversations Conversation[]

  @@index([faculty])
  @@index([groupId])
  @@map("students")
}

model Teacher {
  id         String  @id @default(uuid())
  userId     String  @unique
  lastName   String
  firstName  String
  middleName String?
  department String
  position   String

  user            User             @relation(fields: [userId], references: [id], onDelete: Restrict)
  scheduleEntries ScheduleEntry[]
  officeHours     OfficeHour[]
  conversations   Conversation[]
  studyPlans      StudyPlan[]

  @@index([department])
  @@map("teachers")
}

model Subject {
  id      String @id @default(uuid())
  name    String
  code    String @unique
  faculty String

  scheduleEntries ScheduleEntry[]
  grades          Grade[]

  @@index([faculty])
  @@map("subjects")
}

model Group {
  id        String @id @default(uuid())
  name      String @unique
  faculty   String
  course    Int
  direction String

  students      Student[]
  scheduleEntries ScheduleEntry[]
  announcements Announcement[]
  identityRegistry IdentityRegistry[]

  @@index([faculty, course])
  @@map("groups")
}

model ScheduleEntry {
  id          String         @id @default(uuid())
  groupId     String
  subjectId   String
  teacherId   String
  date        DateTime       @db.Date
  startTime   String
  endTime     String
  room        String
  type        ScheduleType
  status      ScheduleStatus @default(SCHEDULED)
  note        String?
  movedToDate DateTime?      @db.Date
  movedToRoom String?

  group   Group   @relation(fields: [groupId], references: [id], onDelete: Cascade)
  subject Subject @relation(fields: [subjectId], references: [id], onDelete: Restrict)
  teacher Teacher @relation(fields: [teacherId], references: [id], onDelete: Restrict)

  @@index([groupId, date])
  @@index([teacherId, date])
  @@map("schedule_entries")
}

model Grade {
  id        String    @id @default(uuid())
  studentId String
  subjectId String
  value     Int?
  passed    Boolean?
  type      GradeType
  date      DateTime  @db.Date
  semester  Int

  student Student @relation(fields: [studentId], references: [id], onDelete: Cascade)
  subject Subject @relation(fields: [subjectId], references: [id], onDelete: Restrict)

  @@unique([studentId, subjectId, semester, type])
  @@index([studentId, semester])
  @@map("grades")
}

model Request {
  id           String        @id @default(uuid())
  studentId    String
  type         RequestType
  formData     Json
  status       RequestStatus @default(NEW)
  staffComment String?
  createdAt    DateTime      @default(now())
  updatedAt    DateTime      @updatedAt

  student Student @relation(fields: [studentId], references: [id], onDelete: Cascade)

  @@index([studentId, createdAt])
  @@index([status])
  @@map("requests")
}

model Announcement {
  id          String               @id @default(uuid())
  title       String
  body        String
  audience    AnnouncementAudience
  faculty     String?
  groupId     String?
  pinned      Boolean              @default(false)
  authorId    String
  publishedAt DateTime             @default(now())

  author User   @relation(fields: [authorId], references: [id], onDelete: Restrict)
  group  Group? @relation(fields: [groupId], references: [id], onDelete: Cascade)

  @@index([audience, publishedAt])
  @@map("announcements")
}

model Notification {
  id        String           @id @default(uuid())
  userId    String
  type      NotificationType
  title     String
  body      String
  read      Boolean          @default(false)
  link      String?
  createdAt DateTime         @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, read])
  @@map("notifications")
}

model Session {
  id        String   @id @default(uuid())
  userId    String
  tokenHash String   @unique
  expiresAt DateTime
  createdAt DateTime @default(now())
  ip        String?
  userAgent String?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("sessions")
}

model AuditEvent {
  id          String   @id @default(uuid())
  actorUserId String
  action      String
  entity      String
  entityId    String?
  meta        Json?
  createdAt   DateTime @default(now())

  actor User @relation(fields: [actorUserId], references: [id], onDelete: Restrict)

  @@index([entity, entityId])
  @@index([createdAt])
  @@map("audit_events")
}

/// Синтетический реестр студенческих билетов для мок-сверки при верификации.
/// В прототипе заменяет справку из «системы университета»: реальные ПДн не
/// обрабатываются, все записи вымышленные.
model IdentityRegistry {
  id         String   @id @default(uuid())
  cardNumber String   @unique
  lastName   String
  firstName  String
  middleName String?
  groupId    String
  faculty    String
  program    String
  course     Int
  issuedAt   DateTime @db.Date

  group Group @relation(fields: [groupId], references: [id], onDelete: Restrict)

  @@index([groupId])
  @@index([lastName])
  @@map("identity_registry")
}

/// Заявка на верификацию по фото студенческого билета.
/// Фото лежит в приватном хранилище вне webroot (см. packages/core/src/storage.ts),
/// idCardPhotoPath — путь относительно корня хранилища, публичных ссылок нет.
model StudentVerification {
  id                   String             @id @default(uuid())
  studentId            String             @unique
  status               VerificationStatus @default(PENDING)
  idCardPhotoPath      String
  recognizedLastName   String
  recognizedFirstName  String
  recognizedGroupName  String
  recognizedCardNumber String
  matchScore           Float?
  reviewerId           String?
  reviewComment        String?
  submittedAt          DateTime           @default(now())
  reviewedAt           DateTime?
  createdAt            DateTime           @default(now())
  updatedAt            DateTime           @updatedAt

  student  Student @relation(fields: [studentId], references: [id], onDelete: Cascade)
  reviewer User?   @relation("VerificationReviewer", fields: [reviewerId], references: [id], onDelete: SetNull)

  @@index([status, submittedAt])
  @@map("student_verifications")
}

/// Привязка университетской учётной записи к OAuth-провайдеру
/// (VK ID / MAX / Telegram). В прототипе согласие эмулируется — OAuthIntent.
model OAuthAccount {
  id                String        @id @default(uuid())
  userId            String
  provider          OAuthProvider
  providerAccountId String        @unique
  createdAt         DateTime      @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, provider])
  @@map("oauth_accounts")
}

/// Эмуляция OAuth-согласия: одноразовый state, заявленный логин/ФИО/группа
/// и цель входа. Реальных ключей провайдеров в прототипе нет.
model OAuthIntent {
  state     String   @id
  provider  OAuthProvider
  login     String?
  fullName  String?
  groupName String?
  purpose   String
  expiresAt DateTime
  consumedAt DateTime?
  createdAt DateTime @default(now())

  @@index([expiresAt])
  @@map("oauth_intents")
}

/// Одноразовый код привязки канала к учётной записи (BRIEF v3): студент
/// берёт код в кабинете (раздел «Каналы») и отправляет его боту командой
/// /link. Код — 6 символов без неоднозначных (0/O, 1/I), живёт 10 минут,
/// гасится при использовании. provider = null — код принимается любым
/// каналом; иначе только своим (код, выданный на Telegram, не привяжет VK).
model BotLinkCode {
  code       String        @id
  userId     String
  provider   OAuthProvider?
  expiresAt  DateTime
  consumedAt DateTime?
  createdAt  DateTime      @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([expiresAt])
  @@map("bot_link_codes")
}

/// Outbox доставки уведомлений в каналы пользователя (BRIEF v3): одна
/// запись на канал. Уведомление создаётся в кабинете (как для сайта),
/// а адаптеры каналов забирают PENDING-записи и отправляют их боту.
/// Демо-режим (ключей бота нет) закрывается статусом DEMO — сценарии
/// проходимы жюри end-to-end, но канал честно помечен как демо.
model ChannelDelivery {
  id       String                @id @default(uuid())
  userId   String
  provider OAuthProvider
  title    String
  body     String
  status   ChannelDeliveryStatus @default(PENDING)
  error    String?
  createdAt DateTime             @default(now())
  sentAt   DateTime?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, createdAt])
  @@index([status])
  @@map("channel_deliveries")
}

/// Статус «болею»: период заболевания студента. Виден преподавателям
/// и деканату (в прототипе — синтетический реестр), влияет на посещаемость.
model SickLeave {
  id             String   @id @default(uuid())
  studentId      String
  dateFrom       DateTime @db.Date
  dateTo         DateTime @db.Date
  reason         String?
  attachmentPath String?
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  student Student @relation(fields: [studentId], references: [id], onDelete: Cascade)

  @@index([studentId, dateFrom])
  @@index([dateFrom, dateTo])
  @@map("sick_leaves")
}

/// Консультации и часы приёма преподавателя (видно студенту, чтобы понять,
/// когда можно подойти).
model OfficeHour {
  id        String        @id @default(uuid())
  teacherId String
  weekday   Int
  startTime String
  endTime   String
  room      String
  type      OfficeHourType
  note      String?

  teacher Teacher @relation(fields: [teacherId], references: [id], onDelete: Cascade)

  @@index([teacherId, weekday])
  @@map("office_hours")
}

/// Диалог студента с преподавателем (BRIEF v2 §4). Один диалог на пару
/// студент—преподаватель (@@unique): повторное «написать» открывает тот же
/// диалог, а не плодит новые. Переписка доступна только верифицированным
/// студентам — гейт проверяется в services/messaging.ts, не в UI.
model Conversation {
  id        String   @id @default(uuid())
  studentId String
  teacherId String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  student  Student   @relation(fields: [studentId], references: [id], onDelete: Cascade)
  teacher  Teacher   @relation(fields: [teacherId], references: [id], onDelete: Cascade)
  messages Message[]

  @@unique([studentId, teacherId])
  @@index([teacherId, updatedAt])
  @@map("conversations")
}

/// Сообщение переписки. authorUserId — автор (User), владение диалогом
/// проверяется по паре studentId/teacherId из сессии (services/messaging.ts).
/// readAt проставляет получатель — счётчик непрочитанных считается по нему.
model Message {
  id             String    @id @default(uuid())
  conversationId String
  authorUserId   String
  body           String
  readAt         DateTime?
  createdAt      DateTime  @default(now())

  conversation Conversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  author       User         @relation(fields: [authorUserId], references: [id], onDelete: Cascade)

  @@index([conversationId, createdAt])
  @@map("messages")
}

/// Учебный план преподавателя для RAG-ассистента (BRIEF v2 §5, P2b).
/// Модель нужна уже в P2a: файл лежит в приватном хранилище
/// (storage/study-plans/<teacherId>/…), обработка и ответы по плану —
/// отдельный этап P2b. storagePath — путь относительно корня хранилища,
/// публичных ссылок нет.
model StudyPlan {
  id          String   @id @default(uuid())
  teacherId   String
  title       String
  fileName    String
  mime        String
  sizeBytes   Int
  storagePath String
  uploadedAt  DateTime @default(now())

  teacher Teacher @relation(fields: [teacherId], references: [id], onDelete: Cascade)

  @@index([teacherId, uploadedAt])
  @@map("study_plans")
}
