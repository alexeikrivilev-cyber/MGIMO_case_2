# Скопируй в .env: cp .env.example .env

# Переменные сервиса db в docker-compose.yml
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_DB=horizon

# Строка подключения Prisma к локальной базе
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/horizon?schema=public"

# Отдельная база для тестов packages/core (тесты не трогают прод-базу).
# Создание: docker exec horizon-db psql -U postgres -c "CREATE DATABASE horizon_test"
# Миграции: DATABASE_URL=$DATABASE_URL_TEST npm run db:deploy -w @udgu/db
# DATABASE_URL_TEST="postgresql://postgres:postgres@localhost:5432/horizon_test?schema=public"

# Необязательно: корень приватного хранилища фото студбилетов (вне webroot).
# По умолчанию — каталог storage/ в корне монорепо (определяется по расположению
# кода, а не по рабочему каталогу процесса). Если переопределяете — указывайте
# абсолютный путь, относительный считается от рабочего каталога процесса.
# STORAGE_DIR="/var/lib/udgu-deanery/storage"

# Токены ботов каналов доступа (BRIEF v3): Telegram / VK / MAX.
# Пусто = канал в ДЕМО-режиме: сценарии проходимы в симуляторе на /channels,
# доставки честно закрываются статусом DEMO (не притворяются отправленными).
# Токен живёт только здесь (на сервере) — в коде, ответах API и браузере его нет.
# TELEGRAM_BOT_TOKEN=
# VK_BOT_TOKEN=
# MAX_BOT_TOKEN=

# Необязательно: интервал разбора очереди уведомлений каналов, мс
# (по умолчанию 15000; минимум 1000).
# BOT_DISPATCH_INTERVAL_MS=15000

# MCP-сервер для агентов деканата (apps/mcp-server, BRIEF v2 §7).
# MCP_SESSION_TOKEN — токен сессии кабинета сотрудника (значение cookie
# udgu_session после входа staff1/admin1). ТОКЕН РАВНОСИЛЕН ПАРОЛЮ: живёт
# только здесь (на сервере), в код, логи и ответы API не попадает никогда.
# Пусто = сервер не авторизует ни один вызов (все инструменты отвечают
# отказом про токен).
# MCP_SESSION_TOKEN=

# Транспорт MCP-сервера: stdio (по умолчанию, агент поднимает дочерний
# процесс) или http.
# MCP_TRANSPORT=stdio

# HTTP-транспорт: порт и хост привязки (по умолчанию 8787 / 127.0.0.1 —
# только локальный интерфейс). Авторизация — заголовок
# Authorization: Bearer <MCP_SESSION_TOKEN>.
# MCP_HTTP_PORT=8787
# MCP_HTTP_HOST=127.0.0.1
# Необязательно: свои списки разрешённых Host/Origin для DNS-rebinding
# защиты (по умолчанию — localhost и хост привязки, с портом и без).
# MCP_HTTP_ALLOWED_HOSTS=localhost,127.0.0.1
# MCP_HTTP_ALLOWED_ORIGINS=localhost,127.0.0.1

NODE_ENV="development"
